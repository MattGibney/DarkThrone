{
  "name": "worktree-manager",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/worktree-manager/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/worktree-manager"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "npx nx run worktree-manager:serve-ui",
          "node tools/dev.d/manager-server.mjs"
        ]
      }
    },
    "serve-ui": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "worktree-manager:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "worktree-manager:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "worktree-manager:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "worktree-manager:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "worktree-manager:build:development"
        },
        "production": {
          "buildTarget": "worktree-manager:build:production"
        }
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
